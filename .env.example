# Public site URL (used for canonical links, sitemap, Open Graph, share links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Convex — written automatically by `npx convex dev`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Shared secret between this Next.js server and Convex so ONLY the server can
# call the PIN sign-in action. Must match ADMIN_SERVER_SECRET set on Convex.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SERVER_SECRET=

# Set these on CONVEX (not here):
#   npx convex env set ADMIN_SERVER_SECRET <same value as above>
#   npx convex env set ADMIN_PIN <6-12 digit initial PIN>
#
# Photos are stored on Cloudinary (Dashboard → Settings → API Keys). Also set
# these on CONVEX only — the API secret must never be exposed to the browser:
#   npx convex env set CLOUDINARY_CLOUD_NAME <cloud name>
#   npx convex env set CLOUDINARY_API_KEY <api key>
#   npx convex env set CLOUDINARY_API_SECRET <api secret>
